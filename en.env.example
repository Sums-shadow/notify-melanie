# Node.js Server Configuration
PORT=3000

# Email Service Configuration (Nodemailer)
# Example: Hostinger (port 465, SSL)
MAIL_ENABLED=true
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=your_email@yourdomain.com
MAIL_PASS=your_email_password
MAIL_FROM_ADDRESS="Your Name <your_email@yourdomain.com>"

# Twilio SMS Service Configuration
SMS_ENABLED=false
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+15017122661 # Your Twilio phone number

# Twilio WhatsApp Service Configuration (requires Twilio API for WhatsApp)
WHATSAPP_ENABLED=false
# TWILIO_ACCOUNT_SID and TWILIO_AUTH_TOKEN are reused from SMS config
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886 # Your Twilio WhatsApp number

# Telegram Service Configuration
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID # Can be a user ID or group chat ID

# Rate Limiter Configuration
RATE_LIMIT_WINDOW_MS=60000 # 1 minute
RATE_LIMIT_MAX_REQUESTS=100 # Max 100 requests per window

# Security - Basic Bot/Attack Prevention (optional, can be integrated with more advanced solutions)
# HONEYPOT_FIELD_NAME=email_confirm # Example for a honeypot field
